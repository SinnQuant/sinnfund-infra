server {
    server_name sinnfund.jkoh.dev;

    # Landing page
    location = / {
	    root /var/www/sinnfund;
	    try_files /index.html =404;
	}

    # Previous-day-close dashboard
    location = /close {
        return 301 /close/;
    }

    location /close/ {
        proxy_pass http://127.0.0.1:8001/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Pseudo-live dashboard
    location = /live {
        return 301 /live/;
    }

    location /live/ {
        proxy_pass http://127.0.0.1:8002/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # Prediction apis
    location = /prediction {
        return 301 /prediction/;
    }

    location /prediction/ {
        proxy_pass http://127.0.0.1:8003/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # Preserve existing application
    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/sinnfund.jkoh.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/sinnfund.jkoh.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = sinnfund.jkoh.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name sinnfund.jkoh.dev;
    return 404; # managed by Certbot
}
